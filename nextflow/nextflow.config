profiles {
    lsf {
        process {
            executor = 'lsf'

            withLabel: small {
                queue = 'long'
                memory = '2 GB'
                cpus = 5
            }

            withLabel: large {
                queue = 'long'
                memory = '6 GB'
                cpus = 20
            }

            withLabel: gpu {
                queue = 'long'
                memory = '6 GB'
                cpus = 10
                clusterOptions = '-R "select[gpu]" -gpu "num=1:j_exclusive=yes"'
            }
        }

        conda.enabled = true
    }

    slurm_small {
        process {
            executor = 'slurm'
            withLabel: small {
                queue = 'cpu'
                memory = '3 GB'
                cpus = 1
                clusterOptions = '--ntasks=1'
            }

            withLabel: large {
                queue = 'gpu'
                memory = '5 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=2:00:00'
            }

            withLabel: gpu {
                queue = 'gpu'
                memory = '5 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: preprocess_splitting {
                queue = 'gpu'
                memory = '5 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: trainer {
                queue = 'gpu'
                memory = '5 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=2:00:00'

            }
        }

        executor {
            queueSize = 50
            pollInterval = '5 sec'
            queueStatInterval = '5 sec'
            queueGlobalStatus = true
        }

        conda.enabled = true
    }

    slurm {
        process {
            executor = 'slurm'
            withLabel: small {
                queue = 'cpu'
                memory = '20 GB'
                cpus = 1
                clusterOptions = '--ntasks=1'
            }

            withLabel: large {
                queue = 'gpu'
                memory = '50 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=2:00:00'
            }

            withLabel: gpu {
                queue = 'gpu'
                memory = '15 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: preprocess_splitting {
                queue = 'gpu'
                memory = '20 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: trainer {
                queue = 'gpu'
                memory = '12 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'

            }
        }

        executor {
            queueSize = 50
            pollInterval = '5 sec'
            queueStatInterval = '5 sec'
            queueGlobalStatus = true
        }

        conda.enabled = true
    }

    slurm_big {
        process {
            executor = 'slurm'
            withLabel: small {
                queue = 'cpu'
                memory = '20 GB'
                cpus = 1
                clusterOptions = '--ntasks=1'
            }

            withLabel: large {
                queue = 'gpu'
                memory = '50 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=2:00:00'
            }

            withLabel: gpu {
                queue = 'gpu'
                memory = '60 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: preprocess_splitting {
                queue = 'gpu'
                memory = '60 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: trainer {
                queue = 'gpu'
                memory = '30 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=1d --time=4:00:00 --constraint=gpuram80gb'

            }
        }

        executor {
            queueSize = 30
            pollInterval = '5 sec'
            queueStatInterval = '5 sec'
            queueGlobalStatus = true
        }

        conda.enabled = true
    }

    slurm_xlarge {
        process {
            executor = 'slurm'
            withLabel: small {
                queue = 'cpu'
                memory = '20 GB'
                cpus = 1
                clusterOptions = '--ntasks=1'
            }
            withLabel: preprocess_splitting {
                queue = 'gpu'
                memory = '60 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=3h --time=1:00:00'
            }
            withLabel: trainer {
                queue = 'gpu'
                memory = '200 GB'
                cpus = 1
                clusterOptions = '--gres=gpu:1 --ntasks=1 --qos=1d --time=4:00:00 --constraint=gpuram80gb'
                errorStrategy = 'retry'
                maxRetries = 3
            }
        }

        executor {
            queueSize = 30
            pollInterval = '5 sec'
            queueStatInterval = '5 sec'
            queueGlobalStatus = true
        }

        conda.enabled = true
    }


    local {
        process {
            executor = 'local'

            withLabel: gpu {
                maxForks = 1
            }
        }

        executor {
            queueSize = 10
            pollInterval = '5 sec'
        }

        conda.enabled = true
    }
}
